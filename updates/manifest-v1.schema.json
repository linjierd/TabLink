{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tablink.example/schemas/stable-update-payload-v1.json",
  "title": "TabLink stable update payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "channel",
    "releaseId",
    "publishedAtUtc",
    "rolloutPercentage",
    "minimumProtocolVersion",
    "artifacts"
  ],
  "properties": {
    "schema": { "const": 1 },
    "channel": { "const": "stable" },
    "releaseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "publishedAtUtc": {
      "type": "string",
      "description": "UTC publication time at exact whole-second precision.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rolloutPercentage": {
      "type": "integer",
      "description": "Stable cohort percentage. Zero is a signed pause and must not select or download an artifact.",
      "minimum": 0,
      "maximum": 100
    },
    "minimumProtocolVersion": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version", "build", "url", "size", "sha256"],
      "properties": {
        "platform": {
          "enum": ["windows-x64", "android", "ios", "harmony"]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "build": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "installerUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "notes": {
          "type": "string",
          "maxLength": 4096
        }
      }
    }
  }
}
