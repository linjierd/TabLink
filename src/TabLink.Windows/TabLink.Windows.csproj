<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TabLink</AssemblyName>
    <Version>0.8.5</Version>
    <Authors>张林杰（Jey / @linjierd）</Authors>
    <Company>张林杰（Jey / @linjierd）</Company>
    <Product>TabLink</Product>
    <Copyright>Copyright © 2026 张林杰（Jey / @linjierd） and TabLink contributors</Copyright>
    <PackageProjectUrl>https://linjie.space/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/linjierd/TabLink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableBrowserReceiver Condition="'$(EnableBrowserReceiver)' == ''">true</EnableBrowserReceiver>
    <DefineConstants Condition="'$(EnableBrowserReceiver)' != 'true'">$(DefineConstants);TABLINK_NO_BROWSER</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../TabLink.Core/TabLink.Core.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../TabLink.Updater/TabLink.Updater.csproj" ReferenceOutputAssembly="false" /></ItemGroup>
  <ItemGroup><PackageReference Include="QRCoder" Version="1.6.0" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.16" Condition="'$(EnableBrowserReceiver)' == 'true'" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="../../browser/assets/*" Link="BrowserAssets/%(Filename)%(Extension)" Condition="'$(EnableBrowserReceiver)' == 'true'" />
    <Content Include="update-channel.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../third_party/sipsorcery/10.0.16/LICENSE.md;../../third_party/sipsorcery/10.0.16/NOTICE.md;../../third_party/sipsorcery/10.0.16/sipsorcery.nuspec" Link="licenses/sipsorcery/10.0.16/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(EnableBrowserReceiver)' == 'true'" />
  </ItemGroup>
  <Target Name="CopyTabLinkUpdater" AfterTargets="Build">
    <ItemGroup>
      <_TabLinkUpdaterFiles Include="../TabLink.Updater/bin/$(Configuration)/net10.0-windows/$(RuntimeIdentifier)/TabLink.Updater.*" Condition="'$(RuntimeIdentifier)' != ''" />
      <_TabLinkUpdaterFiles Include="../TabLink.Updater/bin/$(Configuration)/net10.0-windows/TabLink.Updater.*" Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_TabLinkUpdaterFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyTabLinkUpdaterToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_TabLinkUpdaterPublishFiles Include="../TabLink.Updater/bin/$(Configuration)/net10.0-windows/$(RuntimeIdentifier)/TabLink.Updater.*" Condition="'$(RuntimeIdentifier)' != ''" />
      <_TabLinkUpdaterPublishFiles Include="../TabLink.Updater/bin/$(Configuration)/net10.0-windows/TabLink.Updater.*" Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_TabLinkUpdaterPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
