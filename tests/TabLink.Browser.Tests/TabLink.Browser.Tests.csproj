    <Compile Include="../../src/TabLink.Windows/VideoQuality.cs" Link="VideoQuality.cs" />
    <Compile Include="../../src/TabLink.Windows/VideoEncoderSelection.cs" Link="VideoEncoderSelection.cs" />
    <Compile Include="../../src/TabLink.Windows/NetworkSessionOptions.cs" Link="NetworkSessionOptions.cs" />
    <Compile Include="../../src/TabLink.Windows/TrustedPairingProtocol.cs" Link="TrustedPairingProtocol.cs" />
    <Compile Include="../../src/TabLink.Windows/InputDesktopAvailability.cs" Link="InputDesktopAvailability.cs" />
    <Compile Include="../../src/TabLink.Windows/SessionPresentationDeadline.cs" Link="SessionPresentationDeadline.cs" />
    <Compile Include="../../src/TabLink.Windows/AnnexBParser.cs" Link="AnnexBParser.cs" />
