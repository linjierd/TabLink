        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Microsoft.Extensions.Logging.Abstractions" version="10.0.11" exclude="Build,Analyzers" />
      </group>
    </dependencies>
