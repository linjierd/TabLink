    <string name="home_title">TabLink · 平板副屏</string><string name="home_subtitle">通过无线或 USB 数据线，把平板或手机变成电脑的第二块屏幕。</string><string name="scan_computer_qr">扫描电脑二维码</string><string name="paste_connection_link">粘贴连接链接</string><string name="reconnect_last_computer">重连上次配对的电脑</string><string name="reconnect_trusted_computer">重连可信电脑 · %1$s</string>
    <string name="connection_instructions">Wi-Fi：本设备和电脑连接同一局域网，再扫描电脑端显示的二维码。\n\nUSB：连接数据线，在 Android 设置中开启“USB 网络共享”，然后扫描电脑端的 USB 网络二维码。无需 USB 调试。</string>
    <string name="open_usb_tethering_settings">打开 USB 网络共享设置</string><string name="legacy_adb_hint">已配置 ADB 的设备仍可由电脑端启动。播放时长按统计文字，或使用返回手势打开设置。</string><string name="status_choose_connection">请选择连接方式</string><string name="status_choose_connection_registered">请选择连接方式；已登记电脑可点“重连可信电脑”自动发现。</string><string name="status_scan_to_connect">扫描电脑端二维码连接；Wi-Fi 或 USB 网络共享均无需 USB 调试。</string><string name="status_waiting_connection">TabLink · 等待连接</string><string name="hud_content_description">统计信息；长按打开显示设置。</string><string name="toast_current_trusted_computer">当前会话正在使用这台可信电脑。</string><string name="toast_invalid_connection_ignored">已忽略无效的 TabLink 连接链接。</string>
    <string name="pairing_replace_title">确认更换可信电脑</string><string name="pairing_connect_title">确认连接这台电脑</string><string name="pairing_replace_message">外部链接请求把当前连接更换为 %1$s。\n\n证书：%2$s…\n\n只有这是你刚刚主动打开的 TabLink 二维码或连接链接时，才继续连接。</string><string name="pairing_connect_message">外部链接请求连接 %1$s。\n\n证书：%2$s…\n\n只有这是你刚刚主动打开的 TabLink 二维码或连接链接时，才继续连接。</string><string name="pairing_cancelled">已取消外部连接请求</string><string name="pairing_kept_original">已保留原可信电脑</string><string name="pairing_invalid">这不是有效的 TabLink 连接链接。请在电脑端生成新二维码后重试。</string><string name="paste_dialog_title">粘贴电脑端连接链接</string><string name="paste_dialog_message">在电脑端复制连接链接后粘贴到这里。链接只用于当前电脑会话。</string><string name="manual_tether_settings">请手动打开 Android 设置 → 热点与网络共享 → USB 网络共享。</string>
    <string name="settings_title">TabLink · 设置</string><string name="settings_instruction">长按统计文字或返回手势打开此面板。设置即时保存，关闭后继续全屏观看。</string><string name="settings_change_connection">更换连接 / 扫描二维码</string><string name="settings_forget_computer">忘记上次配对的电脑</string><string name="forget_complete_button">已删除可信电脑和设备密钥</string><string name="forget_complete_status">可信电脑记录和 Android Keystore 设备密钥均已删除。</string><string name="forget_retry_button">重试删除可信电脑</string><string name="forget_metadata_failed">未能写入可信电脑存储；原记录和设备密钥已保留，请释放存储空间后重试。</string><string name="forget_identity_failed">Android Keystore 设备密钥仍然存在；可信电脑记录已保持删除前状态，请解锁设备后重试。</string><string name="forget_identity_unknown_button">重试确认设备密钥删除</string><string name="forget_identity_unknown">无法确认 Android Keystore 密钥状态；为安全起见已删除可信电脑记录和当前配对链接，请重启应用后重试清理，再重新扫码。</string><string name="forget_rollback_failed_button">检查后重试删除</string><string name="forget_rollback_failed">删除失败且未能完整恢复本地记录；不会报告成功，请重新启动 TabLink 后检查并重试。</string><string name="language_title">语言</string><string name="language_save_failed">无法保存语言设置；将继续使用原来的语言。</string><string name="language_applied_live">语言已切换；当前副屏连接保持不断开。</string><string-array name="language_modes"><item>跟随系统</item><item>简体中文</item><item>English</item></string-array>
    <string name="update_settings_title">正式版更新</string><string-array name="update_modes"><item>自动更新</item><item>自动下载，手动安装</item><item>从不更新</item></string-array><string name="update_check_continue">检查 / 继续正式版更新</string><string name="update_explanation">更新清单会从个人博客和 GitHub 获取并验证签名；下载包还会核对大小和 SHA-256。“自动更新”会在副屏空闲时打开 Android 系统安装确认，“自动下载，手动安装”只准备更新包，“从不更新”不会联网检查。Android 安装仍需在系统界面确认。</string><string name="update_source_blog">个人博客</string><string name="update_source_failure">%1$s：%2$s</string><string name="update_no_source">没有配置可用更新源。</string><string name="update_source_conflict_blocked">更新源冲突仍被阻断；等待发布时间更新的有效签名决定。</string><string name="update_install_state_damaged">Android 安装状态记录已损坏；已清理，可重试安装。</string><string name="update_install_in_progress">Android 安装仍在进行；正在等待系统结果。</string><string name="update_not_checked">尚未检查正式版更新。</string><string name="update_not_configured">更新服务尚未配置。</string><string name="update_save_failed_never">无法保存更新设置；已安全切换为“从不更新”。</string><string name="update_mode_automatic_selected">已选择自动更新。</string><string name="update_mode_download_selected">已选择自动下载后手动安装。</string><string name="update_mode_never_selected">已选择从不更新；不会检查或下载更新。</string><string name="update_allow_unknown_apps">请允许 TabLink 安装未知应用，然后返回继续更新。</string><string name="update_policy_never">更新策略是“从不更新”；请先在设置中更改。</string><string name="update_checking_or_downloading">正在检查或下载正式版更新…</string><string name="update_checking">正在检查正式版更新…</string><string name="update_protocol_newer">最新正式版需要更新的升级协议；请从官网手动安装新版 TabLink。</string><string name="update_current_latest">当前已是最新正式版 %1$s。</string><string name="update_rollout_waiting">正式版 %1$s 正在分批发布，暂未轮到此设备。</string><string name="update_reconfirmed_installing">已重新确认正式版 %1$s，正在准备系统安装…</string><string name="update_found_wait_disconnect">发现正式版 %1$s；副屏断开后自动下载。</string><string name="update_check_failed">检查更新失败：%1$s</string><string name="update_ready_wait_disconnect">更新已就绪，副屏断开后再安装。</string><string name="update_reconfirming">正在重新确认正式版仍可安装…</string><string name="update_cannot_install">更新当前不能安装。</string><string name="update_not_completed_retry">安装未完成；可在设置中点击“检查 / 继续正式版更新”重试。</string><string name="update_downloading">正在后台下载正式版 %1$s…</string><string name="update_download_paused">副屏正在使用；已暂停更新下载，断开后会重试。</string><string name="update_package_mismatch">更新包 SHA-256 或大小不匹配。</string><string name="update_downloaded_reconfirmed">正式版 %1$s 已下载并重新确认，正在准备系统安装…</string><string name="update_staged_protocol_newer">暂存更新需要新版升级协议。</string><string name="update_staged_expired">暂存更新已失效。</string><string name="update_staged_verification_failed">暂存更新校验失败。</string><string name="update_apk_identity_mismatch">APK 包名或版本与签名清单不一致。</string><string name="update_apk_signer_mismatch">APK 安装签名与当前应用不一致。</string><string name="update_unknown_apps_settings_failed">无法打开“安装未知应用”设置。</string><string name="update_apk_changed_during_commit">APK 在提交时大小发生变化。</string><string name="update_session_untracked">无法建立可跟踪的 Android 安装会话；已保留更新包，可在设置中重试。</string><string name="update_submitted">已提交正式版 %1$s；等待 Android 安装结果。</string><string name="update_session_failed">Android 安装会话失败：%1$s；已保留更新包，可在设置中重试。</string><string name="update_cleanup_failed">无法清理损坏的 Android 安装状态；已安全停止自动安装，请重试。</string><string name="update_damaged_cleared_retry">Android 安装状态记录已损坏；已清理，可在设置中重试。</string><string name="update_retry_suffix">%1$s；可在设置中重试。</string><string name="update_generic_failure">网络或校验失败，请稍后重试。</string><string name="update_downloaded_disconnect_install">正式版 %1$s 已下载，将在副屏断开后安装。</string><string name="update_downloaded_installing">正式版 %1$s 已下载，正在准备系统安装…</string><string name="update_downloaded_manual">正式版 %1$s 已下载，等待手动安装。</string><string name="update_install_waiting_confirmation">Android 正在等待安装确认。</string><string name="update_install_deferred_for_display">副屏正在使用；断开后将重新确认并安装更新。</string><string name="update_confirmation_open_failed">无法打开 Android 安装确认页，请在 TabLink 设置中重试。</string><string name="update_install_complete">正式版更新安装完成。</string><string name="update_install_cancelled">安装已取消，可在 TabLink 设置中重试。</string><string name="update_installer_incomplete">Android 安装程序未完成更新。</string>
    <string name="hud_position_title">统计位置</string><string-array name="hud_positions"><item>左上</item><item>上中</item><item>右上</item><item>左中</item><item>正中</item><item>右中</item><item>左下</item><item>下中</item><item>右下</item></string-array><string name="hud_colour_title">文字颜色（#RRGGBB）</string><string name="hud_colour_invalid">请输入 # 和六位颜色，例如 #FFFFFF。</string><string-array name="hud_colours"><item>白</item><item>绿</item><item>青</item><item>黄</item><item>黑</item></string-array><string name="hud_transparency">文字透明度 %1$d%%（不透明度 %2$d%%）</string><string name="hud_transparency_help" formatted="false">0% 完全不透明；100% 隐藏文字。隐藏后仍可用返回手势进入设置。</string><string name="link_open_browser">%1$s，在浏览器中打开。</string><string name="link_invalid">链接无效，无法打开。</string><string name="link_no_browser">未找到可打开此链接的浏览器。</string>
    <string name="status_keystore_unavailable">无法创建 Android Keystore 设备身份；请解锁设备后重试。</string><string name="update_install_prompt_title">安装 TabLink 正式版</string><string name="update_install_prompt">正式版 %1$s 已下载并完成安全校验。%2$s\n\nAndroid 会打开系统安装界面，需要你确认安装。</string><string name="update_active_disconnect_notice">\n\n当前副屏正在使用；继续会先断开连接。</string><string name="update_disconnect_install">断开并安装</string><string name="update_download_prompt_title">下载 TabLink 正式版</string><string name="update_download_prompt">发现正式版 %1$s。当前副屏正在使用；继续会先断开连接，然后下载并校验更新包。</string><string name="update_disconnect_download">断开并下载</string>
    <string name="hud_capture_paused">采集暂停 · %1$s\n长按或返回打开设置</string><string name="capture_paused_default">电脑暂时无法采集画面，等待恢复。</string><string name="hud_selecting_decoder">正在选择</string><string name="hud_network_recovery">网络恢复中 · 等待关键帧</string><string name="hud_decoder_recovery">解码恢复中 · 等待关键帧</string><string name="hud_waiting_first_frame">等待首帧</string><string name="hud_h264_metrics">面板 %1$s · 请求 %2$s\n解码提交 %3$s · 呈现回调 %4$s\n解码器 %5$s · %6$s%7$s</string><string name="hud_high_refresh_brightness"> · 高刷最低亮度</string><string name="hud_presented_fps">%1$s · 呈现回调 %2$.1f fps</string><string name="hud_tablink_status">TabLink · %1$s</string><string name="connection_usb_debug">USB 调试通道</string><string name="connection_trusted">可信电脑 · %1$s</string><string name="connection_encrypted">加密网络 · %1$s</string><string name="status_connected_touch">%1$s 已连接 · %2$d × %3$d · 触摸控制</string><string name="status_connected_telemetry">%1$s 已连接 · %2$d × %3$d · %4$s</string><string name="telemetry_decode_fps">%1$s · 解码 %2$.1f fps</string><string name="decoder_recovered_suffix"> · 已恢复</string><string name="decoder_tier_hardware">硬解</string><string name="decoder_tier_software">软件解码</string><string name="decoder_tier_generic">解码器</string><string name="decoder_selected_fallback_hardware">切换到备用硬解</string><string name="decoder_selected_fallback">切换到%1$s</string><string name="decoder_selected_preferred">首选%1$s</string><string name="decoder_switch_wait_keyframe">H.264 解码器已切换，正在等待关键帧；连接与副屏保持不变。</string><string name="video_queue_wait_keyframe">视频队列正在等待新的关键帧；连接与副屏保持不变。</string><string name="status_connecting">正在连接 %1$s…</string><string name="status_reconnecting">正在重新连接 %1$s…</string><string name="android_device_name">Android 设备</string><string name="installer_busy_reconnect">Android 安装界面正在处理更新；返回 TabLink 后将自动重连。</string><string name="status_connected_waiting_desktop">%1$s 已连接，等待桌面画面…</string><string name="status_connected">%1$s 已连接</string><string name="status_protocol_incompatible">电脑端协议不兼容，请更新两端 TabLink。</string><string name="status_saved_certificate_failed">发现的电脑未通过已保存证书验证，将继续寻找原可信电脑。如电脑已重装或重置，请先忘记可信电脑，再重新扫码。</string><string name="status_certificate_failed">无法验证电脑证书。请检查本设备日期，重新扫描电脑当前二维码；不会使用未验证的连接。</string><string name="status_computer_reported">电脑端提示：%1$s</string><string name="status_computer_reported_untranslated">电脑端报告了错误，请查看电脑端连接记录。</string><string name="status_adb_disconnected">连接中断，请检查 USB 调试通道和电脑端；将自动重连。</string><string name="status_trusted_retry">尚未连通可信电脑，将按已保存地址和局域网发现自动重试；不会信任同名或未验证电脑。</string><string name="status_network_retry">尚未连通电脑，将自动重试。请确认同一 Wi-Fi 或已开启 USB 网络共享，并重新扫描电脑当前二维码。</string><string name="status_untranslated_from_computer">电脑端发来了状态更新，请查看电脑端 TabLink 了解详情。</string><string name="decoder_interrupted">H.264 解码中断（%1$s）。</string><string name="desktop_h264_description">电脑扩展桌面，H.264 硬件解码</string><string name="desktop_touch_description">电脑扩展桌面，单指点击和拖动模拟鼠标</string>
    <string name="qr_instruction">对准电脑端 TabLink 的连接二维码\n请让整个二维码出现在取景框内</string><string name="qr_paste_instead">改为粘贴连接链接</string><string name="qr_camera_permission_denied">未授予相机权限。可返回后重试，或使用下方的粘贴连接链接；粘贴不需要相机权限。</string><string name="qr_camera_unavailable">无法使用相机，可能正被其他应用占用。关闭占用相机的应用后重试，或使用粘贴连接链接。</string><string name="qr_invalid_code">这个二维码不是有效的 TabLink 连接码。请扫描电脑端当前会话的二维码。</string><string name="qr_camera_interrupted">相机连接中断，可返回重试或粘贴连接链接。</string>
