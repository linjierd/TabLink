* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.ps1 text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.swift text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.xml text eol=lf
*.inf text eol=crlf
*.cat binary
*.dll binary
*.jar binary
*.png binary
*.jpg binary
*.h264 binary

# Preserve upstream notices, licenses, patches and signed-driver support files
# byte-for-byte without making their existing whitespace a repository error.
third_party/** -whitespace
tools/ffmpeg/** -whitespace
